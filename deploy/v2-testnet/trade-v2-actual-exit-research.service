[Unit]
Description=V2 real-fill anchored exit shadow and trigger funnel (no trading authority)
After=postgresql@16-tradev2.service trade-v2-clickhouse.service

[Service]
Type=oneshot
User=tradev2exitfacts
Group=tradev2exitfacts
WorkingDirectory=/opt/trade-engine-v2/actual-exit-research
ExecStart=/usr/bin/python3 -m services.v2_actual_exit_research --config /etc/trade-engine-v2/actual-exit-research.json
Environment=V2_ACTUAL_RESEARCH_DSN=postgresql:///trade_v2_testnet?host=/var/run/postgresql&port=55432&user=tradev2exitfacts
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=300
TimeoutStopSec=15
Nice=15
CPUQuota=15%
MemoryMax=192M
TasksMax=16
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
