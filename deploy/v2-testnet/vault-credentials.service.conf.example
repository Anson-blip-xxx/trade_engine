# NOT installed. Requires encrypted credential provisioning + pinned crypto runtime.
# Substitute opaque tenant/registry identifiers in protected runtime config, not Git.
[Service]
LoadCredentialEncrypted=v2-master-v1:/etc/credstore.encrypted/trade-v2-master-v1.cred
Environment=V2_CREDENTIAL_SOURCE=vault
# EnvironmentFile must supply V2_VAULT_TENANT_ID, V2_VAULT_REGISTRY_ID,
# V2_VAULT_BINDING_VERSION. --credentials must reference a TG-only protected file.
LimitCORE=0
