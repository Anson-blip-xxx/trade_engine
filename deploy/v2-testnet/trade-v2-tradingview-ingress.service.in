[Unit]
Description=Trade Engine V2 TradingView Testnet signal ingress
Requires=postgresql@16-tradev2.service
After=network-online.target postgresql@16-tradev2.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=V2_SIGNAL_INGRESS_ENABLED=YES
Environment="V2_POSTGRES_DSN=dbname=trade_v2_testnet host=/var/run/postgresql port=55432 connect_timeout=2"
Environment=V2_POSTGRES_SCHEMA=trade_v2
Environment=V2_ENVIRONMENT=SANDBOX
Environment=V2_SIGNAL_MAX_AGE_MS=300000
Environment=V2_SIGNAL_MAX_LIFETIME_MS=300000
LoadCredential=tradingview-webhook-secret:/var/lib/trade-engine-v2/tradingview-webhook.secret
ExecStart=@PYTHON@ -m services.v2_tradingview_server
Restart=always
RestartSec=10
TimeoutStartSec=20
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/run/postgresql

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trade-v2-tradingview-ingress

[Install]
WantedBy=multi-user.target
