[Unit]
Description=Trade Engine V2 isolated Redis cache
After=local-fs.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/redis-server @PROJECT_ROOT@/deploy/v2-testnet/redis.conf --supervised systemd --daemonize no
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/trade-engine-v2 /var/log/trade-engine-v2

[Install]
WantedBy=multi-user.target
