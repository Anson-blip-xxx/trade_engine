[Unit]
Description=Bounded V2 diagnostic retention with protected trading evidence
After=postgresql@16-tradev2.service

[Service]
Type=oneshot
User=tradev2maintenance
Group=tradev2maintenance
WorkingDirectory=/opt/trade-engine-v2/retention
ExecStart=/usr/bin/python3 -m services.v2_diagnostic_retention --apply
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/trade-engine-v2/retention.env
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=150
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
