# Non-secret service settings only. Never place Binance or Telegram credentials here.
V2_ACCOUNT_ID=replace-with-testnet-account-id
V2_ENVIRONMENT=SANDBOX
V2_INTERVAL_SECONDS=10
V2_SYMBOLS=BTCUSDT,ETHUSDT
V2_EXIT_FEE_RATE=0.0004

# Safe observation mode: no exchange write capability.
V2_ENABLE_ENTRIES=false
V2_ENABLE_PROTECTION_WRITES=false
V2_ENABLE_REDUCE_ONLY_EXITS=false
V2_TESTNET_WRITE_ACK=

# Enabling any write requires the exact account-bound acknowledgement:
# V2_TESTNET_WRITE_ACK=SANDBOX:replace-with-testnet-account-id
