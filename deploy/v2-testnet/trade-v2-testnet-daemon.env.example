# Non-secret service settings only. Never place Binance or Telegram credentials here.
V2_ACCOUNT_ID=replace-with-testnet-account-id
V2_ENVIRONMENT=SANDBOX
V2_INTERVAL_SECONDS=10
# Controller only; 1..60 seconds. Leave room for terminate/kill and supervisor
# finalization within the controller unit's 90-second TimeoutStopSec.
V2_CONTROLLER_STOP_GRACE_SECONDS=30
V2_WATCHDOG_INTERVAL_SECONDS=15
V2_WATCHDOG_HEARTBEAT_MAX_AGE_SECONDS=180
V2_SYMBOLS=BTCUSDT,ETHUSDT
# SANDBOX only: unmanaged positions listed here remain external to V2 lifecycle.
V2_EXTERNAL_POSITION_EXCLUSIONS=
V2_EXIT_FEE_RATE=0.0004

# Safe observation mode: no exchange write capability.
V2_ENABLE_ENTRIES=false
V2_ENABLE_PROTECTION_WRITES=false
V2_ENABLE_REDUCE_ONLY_EXITS=false
V2_TESTNET_WRITE_ACK=

# Registered strategies require shared market capability plus independent PG
# QuantPolicy and account runtime-policy authorization. OFF by default.
V2_SHARED_MARKET=false
V2_ENABLE_QUANT_SIGNALS=false

# Enabling any write requires the exact account-bound acknowledgement:
# V2_TESTNET_WRITE_ACK=SANDBOX:replace-with-testnet-account-id
