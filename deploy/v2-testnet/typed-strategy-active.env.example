# Explicit SANDBOX activation only, after flat/coverage checks and a reviewed
# ACTIVE strategy deployment. This is not the default paused startup template.
# A newer same-binding route request is still required: entry flags alone do
# not authorize opening, including after a controller restart.
# Keep account identities and encrypted credentials in the existing external
# service configuration, never this file or the repository.
V2_ENVIRONMENT=SANDBOX
V2_CONTROLLER_WORKER_MODE=TYPED_STRATEGY
V2_CONTROLLER_ENABLE_ENTRIES=true
V2_ENABLE_ENTRIES=true
V2_TYPED_RECOVER_PAUSED=false
V2_TYPED_INSTANCE=causal-trend-v1
V2_TYPED_LEVERAGE=2
V2_ENTRY_WORK_MS=90000
V2_ENTRY_PROGRESS_TIMEOUT_MS=180000
V2_ENTRY_POLL_MS=50
V2_ENTRY_IDLE_MS=1000
V2_ENTRY_STOP_MS=250
V2_ENTRY_TERMINATE_MS=250
V2_ENTRY_KILL_MS=1000
V2_TYPED_ENTRY_MAX_RESTARTS=3
V2_TYPED_ENTRY_RETRY_MS=1000
V2_TYPED_ENTRY_POLL_MS=50
V2_TYPED_ENTRY_STOP_JOIN_MS=100
V2_INTERVAL_SECONDS=10
V2_EXIT_FEE_RATE=0.0004
V2_SHARED_MARKET=true
