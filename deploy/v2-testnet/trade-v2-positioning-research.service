[Unit]
Description=V2 public positioning evidence archive (no order authority)
After=network-online.target postgresql@16-tradev2.service
Wants=network-online.target

[Service]
Type=oneshot
User=tradev2positioning
Group=tradev2positioning
WorkingDirectory=/opt/trade-engine-v2/positioning-research
ExecStart=/opt/trade-engine-v2/venvs/managed-controller-20260927/bin/python -m services.v2_positioning_entry
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment="V2_POSITIONING_DSN=dbname=trade_v2_testnet host=/var/run/postgresql port=55432 user=tradev2positioning"
Environment=V2_POSITIONING_BATCH_SYMBOLS=8
Environment=V2_POSITIONING_MAX_SECONDS=90
Environment=V2_POSITIONING_MAX_REQUESTS=64
Environment=V2_POSITIONING_MIN_FREE_GIB=10
TimeoutStartSec=150
TimeoutStopSec=15
Nice=15
CPUQuota=15%
MemoryMax=256M
TasksMax=16
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
