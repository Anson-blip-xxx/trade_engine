[Unit]
Description=V2 asynchronous structural re-entry research (no order authority)
After=network.target

[Service]
User=tradev2shadow
Group=tradev2shadow
WorkingDirectory=/opt/trade-engine-v2/reentry-observer
ExecStart=/opt/trade-engine-v2/venvs/managed-controller-20260927/bin/python -m services.v2_reentry_observer_entry
EnvironmentFile=/etc/trade-engine-v2/reentry-observer.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
Nice=15
CPUQuota=15%
MemoryMax=256M
TasksMax=16
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
