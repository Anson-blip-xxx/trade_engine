# Overlay the existing managed Testnet service environment. No account IDs,
# tenants, venue keys, notification secrets or master-key material belong here.
# Keep V2_CONTROLLER_TENANT and V2_ACCOUNT_ID in the existing external config.
V2_ENVIRONMENT=SANDBOX
V2_CONTROLLER_WORKER_MODE=TYPED_STRATEGY
V2_CONTROLLER_ENABLE_ENTRIES=false
V2_ENABLE_ENTRIES=false
V2_TYPED_RECOVER_PAUSED=true
V2_TYPED_INSTANCE=causal-trend-v1
V2_TYPED_LEVERAGE=2
V2_ENTRY_WORK_MS=90000
V2_ENTRY_PROGRESS_TIMEOUT_MS=180000
V2_ENTRY_POLL_MS=50
V2_ENTRY_IDLE_MS=1000
V2_ENTRY_STOP_MS=250
V2_ENTRY_TERMINATE_MS=250
V2_ENTRY_KILL_MS=1000
V2_TYPED_ENTRY_MAX_RESTARTS=3
V2_TYPED_ENTRY_RETRY_MS=1000
V2_TYPED_ENTRY_POLL_MS=50
V2_TYPED_ENTRY_STOP_JOIN_MS=100
V2_INTERVAL_SECONDS=10
V2_EXIT_FEE_RATE=0.0004
V2_SHARED_MARKET=true
# Read-only preflight, using the actual service Python/user/merged environment:
# python -m services.v2_strategy_readiness --symbol BTCUSDT
# paused_boot_ready is not entry_ready, worker READY, or a trading authorization.
